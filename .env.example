NODE_ENV=local
PORT=3010
# Lista de orígenes permitidos separados por coma; sin definir = cualquier origen
# CORS_ORIGINS=http://localhost:3011
LOG_LEVEL=debug
LOG_PATH='logs/app.log'

# Base de datos
DB_HOST=localhost
DB_PORT=53010
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_NAME=ms-expenses

# Auth — genera el secreto con: pnpm run generate:jwt-secret
JWT_SECRET=cambia-esto-por-al-menos-32-caracteres-aleatorios
JWT_EXPIRES_IN=90d

# Alertas por Telegram (el envío llega en F3; aquí solo queda la config)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Hora local a la que corre el cron de alertas (F3)
ALERTS_CRON_HOUR=7

# Sentry (opcional: deja SENTRY_DSN vacío para desactivarlo)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
